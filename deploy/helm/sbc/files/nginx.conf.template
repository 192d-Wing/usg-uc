server {
    listen 8080;
    server_name _;

    # --- Security headers (C10) ---
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${SBC_OIDC_ISSUER}; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        proxy_pass         http://${SBC_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Central config API — phones/directory/trunk groups/dial plans/routing/
    # config (site-scoped, OIDC-bearer). Proxied same-origin to the
    # fleet-wide central-config-api. Runtime data (/api) stays on the daemon.
    location /v1/ {
        proxy_pass         http://${SBC_CENTRAL_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Runtime config for the SPA (envsubst at container start). Supplies the
    # OIDC issuer/client for the central-config sign-in. Empty issuer makes
    # the SPA fall back to its built-in defaults (central features inert).
    #
    # M13: Values are emitted as a JSON object and parsed with JSON.parse()
    # to avoid injection via unescaped env-var content in a JS literal.
    # The env vars must not contain unescaped double-quotes; the entrypoint
    # script should validate this.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 "window.SBC_CONFIG=JSON.parse('{\"centralBase\":\"/v1\",\"oidcIssuer\":\"${SBC_OIDC_ISSUER}\",\"oidcClientId\":\"${SBC_OIDC_CLIENT_ID}\",\"oidcScopes\":\"${SBC_OIDC_SCOPES}\"}');";
    }

    # Phone provisioning. SBC_PROVISION_UPSTREAM resolves to either the
    # stand-alone sbc-provision-server pod (when sbcProvision.enabled)
    # or back to sbc-api / the daemon (which still has the legacy code
    # path mounted) when the dedicated pod is disabled.
    location /provision/ {
        proxy_pass         http://${SBC_PROVISION_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Phones (TEO especially) hit the root path on first-boot — DHCP option
    # 66 only carries a hostname, so firmware fetches /<MAC>.xml or
    # /<MAC>.cfg from the root. Rewrite to /provision/<file> so the
    # canonical endpoint handles it regardless of which upstream owns it.
    # Use `+` (1+ chars) instead of `{12,17}` — nginx-unprivileged's
    # entrypoint runs envsubst over the template and treats `{...}` as
    # a variable-reference fragment in some cases, which truncates the
    # regex at the quantifier and produces `pcre2_compile() failed:
    # missing closing parenthesis`. `+` matches the same MAC patterns
    # in practice.
    location ~ ^/([0-9A-Fa-f:_-]+\.(?:xml|cfg))$ {
        proxy_pass         http://${SBC_PROVISION_UPSTREAM}/provision/$1;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # TEO global config file (TEO spec p.19) — phones fetch this in some
    # firmwares before the per-MAC file. sbc-provision-server serves
    # this at root (/TCS7000A.xml); the legacy daemon path serves it at
    # /provision/TCS7000A.xml. Try the root path first; the upstream
    # will 404 cleanly if it doesn't know the path, which is better
    # than the SPA fallback returning index.html.
    location = /TCS7000A.xml {
        proxy_pass         http://${SBC_PROVISION_UPSTREAM}/TCS7000A.xml;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
