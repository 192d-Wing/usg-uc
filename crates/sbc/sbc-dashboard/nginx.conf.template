# nginx config for the sbc-frontend pod.
#
# Serves the React SPA bundle and reverse-proxies API/provisioning paths to
# the SBC daemon's in-cluster ClusterIP Service ($SBC_API_UPSTREAM).
# Because the browser sees one origin, no CORS is needed.

server {
    listen 8080;
    server_name _;

    # SPA bundle — long-cache hashed assets, no-cache index.html.
    root /usr/share/nginx/html;
    index index.html;

    # Hashed assets (Vite emits content-hashed filenames under /assets/).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # API surface — proxy to the daemon. Trailing slash on proxy_pass is
    # deliberately omitted so the daemon sees the full /api/v1/... path.
    location /api/ {
        proxy_pass         http://${SBC_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Phone provisioning — Yealink/Polycom HTTP config fetch. Same upstream
    # as /api since the daemon still owns provisioning today.
    location /provision/ {
        proxy_pass         http://${SBC_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Phones (TEO especially) hit the root path on first-boot — DHCP option
    # 66 only carries a hostname, so firmware fetches /<MAC>.xml or
    # /<MAC>.cfg from the root. Match a hex MAC (12 chars, any case, with or
    # without colon/dash separators) followed by .xml or .cfg and rewrite
    # to the daemon's canonical /provision/ path. Subsequent refreshes use
    # the update_server URL embedded in the returned XML and hit
    # /provision/ directly.
    location ~ ^/([0-9A-Fa-f:_-]{12,17}\.(?:xml|cfg))$ {
        proxy_pass         http://${SBC_API_UPSTREAM}/provision/$1;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # TEO global config file (TEO spec p.19) — phones fetch this in some
    # firmwares before the per-MAC file. Daemon returns 404 with a clear
    # body; we proxy through so the daemon's 404 (right Content-Type and
    # body) wins over nginx's SPA fallback returning index.html.
    location = /TCS7000A.xml {
        proxy_pass         http://${SBC_API_UPSTREAM}/provision/TCS7000A.xml;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Health probes — these are the daemon's, not nginx's. Kubernetes hits
    # the frontend pod's own /nginx-health for its liveness check.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # SPA fallback — any non-asset, non-API path falls back to index.html so
    # client-side routing works on refresh.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
