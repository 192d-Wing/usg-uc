# nginx config for the sbc-frontend pod.
#
# Serves the React SPA bundle and reverse-proxies API/provisioning paths to
# the SBC daemon's in-cluster ClusterIP Service ($SBC_API_UPSTREAM).
# Because the browser sees one origin, no CORS is needed.

server {
    listen 8080;
    server_name _;

    # SPA bundle — long-cache hashed assets, no-cache index.html.
    root /usr/share/nginx/html;
    index index.html;

    # Hashed assets (Vite emits content-hashed filenames under /assets/).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # API surface — proxy to the daemon. Trailing slash on proxy_pass is
    # deliberately omitted so the daemon sees the full /api/v1/... path.
    location /api/ {
        proxy_pass         http://${SBC_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Phone provisioning — Yealink/Polycom HTTP config fetch. Same upstream
    # as /api since the daemon still owns provisioning today.
    location /provision/ {
        proxy_pass         http://${SBC_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Health probes — these are the daemon's, not nginx's. Kubernetes hits
    # the frontend pod's own /nginx-health for its liveness check.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # SPA fallback — any non-asset, non-API path falls back to index.html so
    # client-side routing works on refresh.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
